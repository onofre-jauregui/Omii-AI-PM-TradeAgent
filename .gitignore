# Environment variables — never commit secrets
.env
.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.claude/session.md

# Playwright MCP snapshots
.playwright-mcp/

# Debug screenshots
*.png

# Test run artifacts (generated by `deno test` / `playwright test`)
test-results/
playwright-report/

# Deno lockfile — regenerated per-machine, never committed here
deno.lock

# git worktrees created by isolated-fix workflow (nested .git — must never be committed)
.claude/worktrees/

# Supabase CLI local link state (project ref only, no secrets, but machine-local)
supabase/.temp/
